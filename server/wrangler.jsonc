{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toycrane",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["python_workers"],
  // 화면(client/dist)을 같은 Worker 정적 자산으로 내보내고, /api·/ws만 Worker가 먼저 받는다
  "assets": {
    "directory": "../client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  // 무료 요금제는 SQLite 기반 Durable Object만 가능
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  "vars": { "MAX_STORES": "4" }
}
